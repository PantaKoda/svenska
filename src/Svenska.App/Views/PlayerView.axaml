<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Svenska.App.ViewModels"
             xmlns:answers="using:Svenska.Core.Answers"
             x:Class="Svenska.App.Views.PlayerView"
             x:DataType="vm:PlayerViewModel"
             Focusable="True">
    <ScrollViewer>
        <StackPanel Margin="40,28" Spacing="18" MaxWidth="760">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Classes="label" Text="{Binding Position}" VerticalAlignment="Center"
                           IsVisible="{Binding !IsFinished}" />
                <Button Classes="ghost" Content="←  Back" Command="{Binding BackCommand}" Focusable="False" Padding="0,6" />
                <TextBlock Classes="muted" Text="{Binding Title}" VerticalAlignment="Center" Margin="16,0" />
            </DockPanel>

            <!-- finished: a quiet end, the same every time -->
            <Border Classes="card" IsVisible="{Binding IsFinished}">
                <StackPanel Spacing="8">
                    <TextBlock Classes="label" Text="ROUND FINISHED" />
                    <TextBlock Classes="h1" Text="Done" />
                    <TextBlock Text="{Binding Summary}" FontSize="16" />
                </StackPanel>
            </Border>

            <!-- one item -->
            <Border Classes="card" IsVisible="{Binding !IsFinished}">
            <StackPanel Spacing="16">
                <!-- a dialogue: what the others say before the learner's reply -->
                <ItemsControl ItemsSource="{Binding Heard}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HeardRow">
                            <Grid ColumnDefinitions="Auto,Auto,90,*" Margin="0,0,0,6">
                                <Button Grid.Column="0" Classes="round" Content="▶" Command="{Binding Play}" Focusable="False" />
                                <Button Grid.Column="1" Classes="round" Content="▶ slow" Command="{Binding PlaySlow}" Margin="6,0,14,0" Focusable="False" />
                                <TextBlock Grid.Column="2" Classes="label" Text="{Binding Speaker}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="3" VerticalAlignment="Center"
                                            IsVisible="{Binding $parent[ItemsControl].((vm:PlayerViewModel)DataContext).IsChecked}">
                                    <TextBlock Text="{Binding Sv}" TextWrapping="Wrap" />
                                    <TextBlock Classes="muted" Text="{Binding En}" TextWrapping="Wrap" FontSize="12" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Classes="muted" Text="{Binding Instruction}" TextWrapping="Wrap" />
                <TextBlock Classes="prompt" Text="{Binding Prompt}" TextWrapping="Wrap"
                           IsVisible="{Binding Prompt, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <!-- empty until the answer is checked wherever it would give the answer away -->
                <TextBlock Classes="muted" Text="{Binding Translation}" TextWrapping="Wrap"
                           IsVisible="{Binding Translation, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasAudio}">
                    <Button Classes="round" Content="▶  Play" Command="{Binding PlayCommand}" Focusable="False" ToolTip.Tip="Ctrl+Space" />
                    <Button Classes="round" Content="▶  Slow" Command="{Binding PlaySlowCommand}" Focusable="False" ToolTip.Tip="Ctrl+Shift+Space" />
                </StackPanel>

                <!-- scene_click -->
                <Border IsVisible="{Binding IsScene}" BorderThickness="1" CornerRadius="12" ClipToBounds="True"
                        BorderBrush="{DynamicResource LineBrush}">
                    <Image x:Name="SceneImage" Source="{Binding SceneImage}" Stretch="Uniform" MaxHeight="360"
                           PointerPressed="OnScenePressed" Cursor="Hand" />
                </Border>

                <!-- listen_choose -->
                <ItemsControl ItemsSource="{Binding Options}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:OptionRow">
                            <Button Content="{Binding Label}" Command="{Binding Choose}" Focusable="False"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    FontSize="17" Padding="18,12" Margin="0,0,0,8" CornerRadius="12"
                                    Classes.right="{Binding IsRight}" Classes.wrong="{Binding IsWrong}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- word_order -->
                <ItemsControl ItemsSource="{Binding Tokens}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TokenRow">
                            <Button Classes="chip" Content="{Binding Text}" Command="{Binding Add}" Margin="0,0,8,8" FontSize="18" Focusable="False" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- typed answers -->
                <DockPanel IsVisible="{Binding IsTyped}">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
                        <Button Classes="round" Content="å" Tag="å" Click="OnLetterClick" Focusable="False" ToolTip.Tip="Alt+A" FontSize="18" />
                        <Button Classes="round" Content="ä" Tag="ä" Click="OnLetterClick" Focusable="False" ToolTip.Tip="Alt+E" FontSize="18" />
                        <Button Classes="round" Content="ö" Tag="ö" Click="OnLetterClick" Focusable="False" ToolTip.Tip="Alt+O" FontSize="18" />
                    </StackPanel>
                    <TextBox x:Name="AnswerBox" Text="{Binding Answer}" FontSize="20" IsReadOnly="{Binding IsChecked}"
                             PlaceholderText="Your answer" />
                </DockPanel>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="{Binding SubmitText}" Command="{Binding SubmitCommand}" Classes="accent" Focusable="False" />
                    <TextBlock Classes="label" Text="ENTER" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Spacing="6" IsVisible="{Binding IsChecked}">
                    <TextBlock Text="{Binding Feedback}" TextWrapping="Wrap" FontSize="16"
                               Classes.right="{Binding IsRight}" Classes.wrong="{Binding !IsRight}" />
                    <ItemsControl ItemsSource="{Binding ExpectedWords}" IsVisible="{Binding !IsRight}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="answers:WordMark">
                                <TextBlock Text="{Binding Word}" FontSize="22" Margin="0,0,8,0" Classes="mark"
                                           Classes.right="{Binding Right}" Classes.wrong="{Binding !Right}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="muted" Text="{Binding GlossText}" FontSize="13" TextWrapping="Wrap"
                               IsVisible="{Binding GlossText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <StackPanel Spacing="6" Margin="0,8,0,0"
                                IsVisible="{Binding GrammarTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <Button Classes="ghost" Command="{Binding ShowGrammarCommand}" Focusable="False" ToolTip.Tip="Open the grammar card" Padding="0,6">
                            <TextBlock Classes="accent" Text="{Binding GrammarTitle, StringFormat='Grammar:  {0}  →'}" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
