<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Svenska.App.ViewModels"
             x:Class="Svenska.App.Views.UnitView"
             x:DataType="vm:UnitViewModel">
    <ScrollViewer>
        <StackPanel Margin="40,28" Spacing="18" MaxWidth="820">
            <Button Classes="ghost" Content="←  Units" Command="{Binding BackCommand}" Padding="0,6" />

            <StackPanel Spacing="8" Margin="0,0,0,6">
                <TextBlock Classes="label" Text="{Binding BookLabel}" IsVisible="{Binding BookLabel, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Classes="h1" Text="{Binding Title}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Task}" TextWrapping="Wrap" FontSize="17" />
                <TextBlock Classes="muted" Text="{Binding CanDo}" TextWrapping="Wrap" />
                <TextBlock Classes="muted" Text="{Binding FocusText}" TextWrapping="Wrap" IsVisible="{Binding FocusText, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>

            <!-- 1 words -->
            <Border Classes="card">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Classes="step"><TextBlock Classes="accent" Text="1" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                        <TextBlock Classes="h2" Text="Words and phrases" VerticalAlignment="Center" />
                        <TextBlock Classes="muted" Text="click one to hear it" VerticalAlignment="Center" FontSize="12" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Words}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WordRow">
                                <Button Classes="chip" Command="{Binding Play}" Margin="0,0,8,8" Width="178">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Swedish}" FontWeight="SemiBold"
                                                   Classes.en="{Binding IsEn}" Classes.ett="{Binding IsEtt}" />
                                        <TextBlock Classes="muted" Text="{Binding Gloss}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- everyday phrases, learnt as a whole -->
                    <StackPanel Spacing="10" IsVisible="{Binding HasPhrases}">
                        <TextBlock Classes="label" Text="PHRASES" Margin="0,4,0,0" />
                        <ItemsControl ItemsSource="{Binding Phrases}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:WordRow">
                                    <Button Classes="chip" Command="{Binding Play}" Margin="0,0,8,8" Width="364">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Swedish}" FontWeight="SemiBold" />
                                            <TextBlock Classes="muted" Text="{Binding Gloss}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 2 listen -->
            <Border Classes="card" IsVisible="{Binding HasDialogue}">
                <StackPanel Spacing="14">
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Content="Show the text" IsChecked="{Binding ShowTranscript}" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Classes="step"><TextBlock Classes="accent" Text="2" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <TextBlock Classes="h2" Text="Listen" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Dialogue}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LineRow">
                                <Grid ColumnDefinitions="Auto,Auto,96,*" Margin="0,0,0,8">
                                    <Button Grid.Column="0" Classes="round" Content="▶" Command="{Binding Play}" ToolTip.Tip="Play" />
                                    <Button Grid.Column="1" Classes="round" Content="▶ slow" Command="{Binding PlaySlow}" Margin="6,0,14,0" />
                                    <TextBlock Grid.Column="2" Classes="label" Text="{Binding Speaker}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center"
                                                IsVisible="{Binding $parent[ItemsControl].((vm:UnitViewModel)DataContext).ShowTranscript}">
                                        <TextBlock Text="{Binding Sv}" TextWrapping="Wrap" />
                                        <TextBlock Classes="muted" Text="{Binding En}" TextWrapping="Wrap" FontSize="12" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="muted" Text="{Binding GlossText}" FontSize="13" TextWrapping="Wrap" IsVisible="{Binding ShowTranscript}" />
                </StackPanel>
            </Border>

            <!-- 3 exercises: the next step, so it carries the accent -->
            <Border Classes="card">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="accent" Content="{Binding StartText}" Command="{Binding StartCommand}"
                            IsEnabled="{Binding HasExercises}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Classes="step"><TextBlock Classes="accent" Text="3" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                        <TextBlock Classes="h2" Text="Exercises" VerticalAlignment="Center" />
                        <TextBlock Classes="muted" Text="{Binding ProgressText}" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 4 final task -->
            <Border Classes="card" IsVisible="{Binding HasFinalTask}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Start the final task" Command="{Binding StartFinalTaskCommand}"
                            VerticalAlignment="Center" Padding="18,10" />
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Classes="step"><TextBlock Classes="accent" Text="4" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <TextBlock Classes="h2" Text="Final task" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Classes="muted" Text="{Binding FinalTaskText}" TextWrapping="Wrap" Margin="38,0,16,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 5 speak -->
            <Border Classes="card" IsVisible="{Binding SpeakingPrompt, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Classes="step"><TextBlock Classes="accent" Text="5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                        <TextBlock Classes="h2" Text="Speak" VerticalAlignment="Center" />
                        <TextBlock Classes="muted" Text="on your own" VerticalAlignment="Center" FontSize="12" />
                    </StackPanel>
                    <TextBlock Text="{Binding SpeakingPrompt}" TextWrapping="Wrap" Margin="38,0,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
