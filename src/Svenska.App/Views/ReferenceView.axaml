<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Svenska.App.ViewModels"
             xmlns:reference="using:Svenska.Core.Reference"
             x:Class="Svenska.App.Views.ReferenceView"
             x:DataType="vm:ReferenceViewModel">
    <DockPanel Margin="22,18">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Classes="ghost" Content="✕" Command="{Binding ToggleCommand}" ToolTip.Tip="Close (Esc)" />
            <StackPanel Spacing="2">
                <TextBlock Classes="label" Text="LOOK IT UP" />
                <TextBlock Classes="h2" Text="Reference" />
            </StackPanel>
        </DockPanel>

        <TabControl SelectedIndex="{Binding SelectedTab}" Padding="0,8,0,0">
            <TabItem Header="Words">
                <DockPanel>
                    <TextBox x:Name="LookupBox" DockPanel.Dock="Top" Text="{Binding Query}"
                             PlaceholderText="bilarna, köpte, större …" FontSize="16" />
                    <ScrollViewer Margin="0,10,0,0">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="muted" Text="{Binding Message}" TextWrapping="Wrap"
                                       IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <ItemsControl ItemsSource="{Binding Suggestions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SuggestionRow">
                                        <Button Content="{Binding Text}" Command="{Binding Use}" Margin="0,0,6,6" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding Entries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="reference:WordEntry">
                                        <Border Padding="16" Margin="0,0,0,10" CornerRadius="14" BorderThickness="1"
                                                BorderBrush="{DynamicResource LineBrush}" Background="{DynamicResource AppBackgroundBrush}">
                                            <StackPanel Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Headword}" FontSize="18" FontWeight="SemiBold" />
                                                    <TextBlock Classes="label" Text="{Binding PartOfSpeech}" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Gloss}" TextWrapping="Wrap"
                                                           IsVisible="{Binding Gloss, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                <TextBlock Classes="accent" Text="{Binding TaughtIn, StringFormat='Unit: {0}'}" FontSize="12"
                                                           IsVisible="{Binding TaughtIn, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                <ItemsControl ItemsSource="{Binding Forms}" Margin="0,4,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="reference:FormRow">
                                                            <Grid ColumnDefinitions="130,*" Margin="0,1">
                                                                <TextBlock Classes="muted" Text="{Binding Label}" FontSize="13" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Forms}" TextWrapping="Wrap" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <TabItem Header="Grammar">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                        <TextBlock Classes="muted" Text="Up to level" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedLevel}" MinWidth="120" />
                    </StackPanel>
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Cards}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CardRow">
                                    <Expander IsExpanded="{Binding IsExpanded}" HorizontalAlignment="Stretch" Margin="0,0,0,4">
                                        <Expander.Header>
                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                        </Expander.Header>
                                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                            <TextBlock Text="{Binding Card}" FontSize="12"
                                                       FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace" />
                                        </ScrollViewer>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
