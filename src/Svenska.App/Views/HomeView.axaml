<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Svenska.App.ViewModels"
             x:Class="Svenska.App.Views.HomeView"
             x:DataType="vm:HomeViewModel">
    <ScrollViewer>
        <StackPanel Margin="40,32" Spacing="26" MaxWidth="980">
            <!-- the one accent on this page: what to do next -->
            <DockPanel>
                <Button DockPanel.Dock="Right" Classes="accent" Content="{Binding ReviewText}" Command="{Binding Review}"
                        VerticalAlignment="Center" />
                <StackPanel Spacing="4">
                    <TextBlock Classes="h1" Text="Hej!" />
                    <TextBlock Classes="muted" Text="Pick a unit, review what is due, or practise a theme." />
                </StackPanel>
            </DockPanel>
            <TextBlock Text="{Binding Status}" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <ItemsControl ItemsSource="{Binding Levels}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LevelGroup">
                        <StackPanel Spacing="12" Margin="0,0,0,22">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Classes="h2" Text="{Binding Level}" />
                                <TextBlock Classes="label" Text="LEVEL" VerticalAlignment="Center" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Units}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:UnitRow">
                                        <Button Classes="tile" Classes.next="{Binding IsNext}" Command="{Binding Open}"
                                                Width="436" Height="138" Margin="0,0,14,14" VerticalContentAlignment="Stretch">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Bottom" Spacing="5">
                                                    <ProgressBar Value="{Binding Percent}" Maximum="100" />
                                                    <TextBlock Classes="muted" Text="{Binding ProgressText}" FontSize="12" />
                                                </StackPanel>
                                                <StackPanel Spacing="3">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Classes="label accent" Text="NEXT" IsVisible="{Binding IsNext}" />
                                                        <TextBlock Classes="label" Text="{Binding Number}" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Classes="muted" Text="{Binding Task}" FontSize="13" TextWrapping="Wrap" MaxHeight="36"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- companion chapters: beside a course book, apart from the task units -->
            <ItemsControl ItemsSource="{Binding Books}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BookGroup">
                        <Border Classes="book" Margin="0,0,0,22">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Classes="h2" Text="Book companion" />
                                    <TextBlock Classes="h2 muted" Text="{Binding Book}" />
                                    <TextBlock Classes="label" Text="EXTRA PRACTICE BY CHAPTER" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="13"
                                           Text="Our own exercises on the grammar of each chapter, to do beside the book. They build on the task units of the same level." />
                                <ItemsControl ItemsSource="{Binding Chapters}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:UnitRow">
                                            <Button Classes="tile" Command="{Binding Open}" Width="288" Height="118" Margin="0,0,12,12"
                                                    VerticalContentAlignment="Stretch">
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Bottom" Spacing="5">
                                                        <ProgressBar Value="{Binding Percent}" Maximum="100" />
                                                        <TextBlock Classes="muted" Text="{Binding ProgressText}" FontSize="12" />
                                                    </StackPanel>
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Classes="label" Text="{Binding Number}" />
                                                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Classes="muted" Text="{Binding Task}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Spacing="12" IsVisible="{Binding Themes.Count}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Classes="h2" Text="Theme practice" />
                    <TextBlock Classes="label" Text="ANY ORDER" VerticalAlignment="Center" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Themes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ThemeRow">
                            <Button Classes="chip" Command="{Binding Open}" Margin="0,0,10,10" Width="214">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Classes="muted" Text="{Binding Detail}" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
